# =============================================================================
# KEIZOKU - Supabase PostgreSQL Cloud Database Configuration (.env)
# =============================================================================
# DO NOT COMMIT YOUR REAL CREDENTIALS TO GIT.
#
# Recommended Connection Modes:
# 1. Supabase Session Pooler (Optimal for Spring Boot backend & Flyway migrations):
#    Host: aws-0-[region].pooler.supabase.com
#    Port: 5432 (Session mode)
#    User: postgres.[your-project-ref]
#
# 2. Supabase Direct Connection:
#    Host: db.[your-project-ref].supabase.co
#    Port: 5432
#    User: postgres
# =============================================================================

# Database JDBC URL (Session Pooler example)
SUPABASE_DB_URL=jdbc:postgresql://aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?user=postgres.ibhketgjfhiavoyfruzb&password=[YOUR-DATABASE-PASSWORD]

# Database Username
SUPABASE_DB_USERNAME=postgres.ibhketgjfhiavoyfruzb

# Database Password
SUPABASE_DB_PASSWORD=343520@RAJkumar
# Active Spring Profile (set to 'supabase' for cloud, 'dev' for local H2)
SPRING_PROFILES_ACTIVE=supabase
