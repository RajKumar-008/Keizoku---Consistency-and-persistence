{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "DayForgeApplication (Spring Boot Server)",
            "request": "launch",
            "mainClass": "com.dayforge.DayForgeApplication",
            "projectName": "dayforge"
        },
        {
            "name": "Launch Chrome (Browser)",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ],
    "compounds": [
        {
            "name": "DayForge: Server + Chrome",
            "configurations": [
                "DayForgeApplication (Spring Boot Server)",
                "Launch Chrome (Browser)"
            ]
        }
    ]
}
