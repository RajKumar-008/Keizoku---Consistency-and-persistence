{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "DayForgeApplication (Dev - Local H2)",
            "request": "launch",
            "mainClass": "com.dayforge.DayForgeApplication",
            "projectName": "dayforge",
            "args": "--spring.profiles.active=dev"
        },
        {
            "type": "java",
            "name": "DayForgeApplication (Production - Supabase)",
            "request": "launch",
            "mainClass": "com.dayforge.DayForgeApplication",
            "projectName": "dayforge",
            "args": "--spring.profiles.active=supabase"
        },
        {
            "name": "Launch Chrome (Browser)",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ],
    "compounds": [
        {
            "name": "DayForge (Dev + Chrome)",
            "configurations": [
                "DayForgeApplication (Dev - Local H2)",
                "Launch Chrome (Browser)"
            ]
        },
        {
            "name": "DayForge (Supabase + Chrome)",
            "configurations": [
                "DayForgeApplication (Production - Supabase)",
                "Launch Chrome (Browser)"
            ]
        }
    ]
}
